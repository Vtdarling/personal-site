<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Veeran's Biography</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <div class="row min-vh-100 align-items-center justify-content-center">
      <div class="col-md-6 col-lg-4">
        <div class="story-card p-5">
          <div class="text-center mb-4">
            <h1 class="display-6 fw-semibold mb-2">🔪 Veeran's Biography</h1>
            <p class="text-muted">Enter password to access</p>
          </div>
          
          <form method="POST" action="/login">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="mb-3">
              <label for="password" class="form-label">Password</label>
              <input 
                type="password" 
                class="form-control" 
                id="password" 
                name="password" 
                placeholder="Enter password"
                required
                autofocus
              />
            </div>
            
            <% if (error) { %>
            <div class="alert alert-danger" role="alert">
              <%= error %>
            </div>
            <% } %>
            
            <% if (isLocked) { %>
            <div class="alert alert-warning" role="alert">
              🔐 Account locked. Too many failed attempts. Try again in 15 minutes.
            </div>
            <% } %>
            
            <button type="submit" class="btn btn-primary w-100" <%= isLocked ? 'disabled' : '' %>>Access Website</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
