<!-- Location: ./views/fitness.ejs -->
<%- include("partials/header") %>

<style>
    :root {
        --coach-grad: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --user-grad: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --glass-bg: rgba(255, 255, 255, 0.95);
    }

    .hero-section {
        background: linear-gradient(120deg, #f0fdf4 0%, #e0f2fe 100%);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .chat-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border-radius: 24px;
        overflow: hidden;
    }

    #chatContainer {
        height: 550px;
        overflow-y: auto;
        padding: 25px;
        scroll-behavior: smooth;
        background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
        background-size: 20px 20px;
    }

    .chat-message {
        margin-bottom: 20px;
        max-width: 85%;
        padding: 14px 20px;
        border-radius: 20px;
        position: relative;
        animation: fadeInUp 0.4s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    @keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .bot-message {
        align-self: flex-start;
        background: var(--coach-grad);
        color: white;
        border-bottom-left-radius: 4px;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);
    }

    .user-message {
        align-self: flex-end;
        background: var(--user-grad);
        color: white;
        border-bottom-right-radius: 4px;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
        margin-left: auto;
    }

    .message-header {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 5px;
        opacity: 0.9;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .message-content ul {
        padding-left: 20px;
        margin-bottom: 0;
    }

    .message-content li {
        margin-bottom: 4px;
    }

    /* Input area styling */
    .input-box {
        background: white;
        padding: 20px;
        border-top: 1px solid #f1f5f9;
    }

    .form-control:focus {
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        border-color: #6363f1;
    }

    .pulse {
        animation: pulse-animation 2s infinite;
    }

    @keyframes pulse-animation {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    .typing-dot {
        width: 8px;
        height: 8px;
        background: #94a3b8;
        border-radius: 50%;
        display: inline-block;
        animation: bounce 1.4s infinite ease-in-out both;
    }
    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }

    @keyframes bounce {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1.0); }
    }
</style>

<section class="hero-section p-5 mb-4 text-center">
  <div class="pulse mb-3 d-inline-block" style="font-size: 3rem;">⚡</div>
  <h1 class="display-5 fw-bold text-dark">Personal Coach AI</h1>
  <p class="lead text-muted">Smart workouts, yoga flows, and healthy meal ideas in seconds.</p>
</section>

<div class="container pb-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="chat-card shadow-lg">
        <div id="chatContainer" class="d-flex flex-column">
          <div class="bot-message chat-message shadow-sm">
            <div class="message-header">💪 Coach AI</div>
            <div class="message-content">
                Hey there! Ready to level up your fitness? I can design a <strong>workout routine</strong>, a <strong>yoga flow</strong>, or give you <strong>health tips</strong>. What are we working on today?
            </div>
          </div>
          <div id="messages" class="d-flex flex-column"></div>
          <div id="typingIndicator" class="chat-message bot-message" style="display: none; background: #f1f5f9; color: #64748b; box-shadow: none; border: 1px solid #e2e8f0;">
              <div class="typing-dot"></div>
              <div class="typing-dot"></div>
              <div class="typing-dot"></div>
          </div>
        </div>

        <div class="input-box">
          <form id="chatForm">
            <div class="input-group input-group-lg">
              <input type="text" id="userInput" class="form-control border-0 bg-light" placeholder="Ask anything fitness..." required autocomplete="off">
              <button class="btn btn-primary px-4 fw-bold" type="submit" id="sendBtn">
                <span id="sendText">Get Plan</span>
                <span id="loadingText" style="display: none;">...</span>
              </button>
            </div>
          </form>
          
          <div class="mt-3 d-flex flex-wrap gap-2">
            <button class="btn btn-sm rounded-pill btn-outline-info prompt-btn" data-prompt="Give me a 10 min core routine">⚡ Abs</button>
            <button class="btn btn-sm rounded-pill btn-outline-success prompt-btn" data-prompt="Quick yoga for flexibility">🧘 Yoga</button>
            <button class="btn btn-sm rounded-pill btn-outline-warning prompt-btn" data-prompt="Lower back pain stretches">🌟 Stretches</button>
            <button class="btn btn-sm rounded-pill btn-outline-danger prompt-btn" data-prompt="15 min HIIT at home">⚡ HIIT</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const chatForm = document.getElementById('chatForm');
  const userInput = document.getElementById('userInput');
  const messagesContainer = document.getElementById('messages');
  const typingIndicator = document.getElementById('typingIndicator');
  const sendBtn = document.getElementById('sendBtn');
  const sendText = document.getElementById('sendText');
  const promptBtns = document.querySelectorAll('.prompt-btn');

  promptBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      userInput.value = btn.dataset.prompt;
      chatForm.dispatchEvent(new Event('submit'));
    });
  });

  chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const message = userInput.value.trim();
    if (!message) return;

    addMessage(message, 'user');
    userInput.value = '';

    // UI Updates
    sendBtn.disabled = true;
    sendText.style.display = 'none';
    typingIndicator.style.display = 'block';
    scrollToBottom();

    try {
      const response = await fetch('/fitness/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message })
      });

      const data = await response.json();
      typingIndicator.style.display = 'none';

      if (data.success) {
        addMessage(data.response, 'bot');
      } else {
        addMessage("⚠️ " + (data.response || 'Connection lost.'), 'bot');
      }
    } catch (error) {
      typingIndicator.style.display = 'none';
      addMessage('❌ Error connecting to Coach. Please try again.', 'bot');
    } finally {
      sendBtn.disabled = false;
      sendText.style.display = 'inline';
      scrollToBottom();
    }
  });

  function addMessage(text, sender) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `chat-message ${sender}-message shadow-sm`;
    
    const icon = sender === 'user' ? '👤' : '💪';
    const label = sender === 'user' ? 'You' : 'Coach AI';
    
    messageDiv.innerHTML = `
      <div class="message-header"><span>${icon}</span> ${label}</div>
      <div class="message-content">${formatMessage(text)}</div>
    `;

    messagesContainer.appendChild(messageDiv);
    scrollToBottom();
  }

  function scrollToBottom() {
    const container = document.getElementById('chatContainer');
    container.scrollTop = container.scrollHeight;
  }

  function formatMessage(text) {
    let formatted = text.trim().replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    
    // Split into lines
    const lines = formatted.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    
    if (lines.length > 2) {
        const items = lines.map(line => {
            // Remove bullet point symbols if AI provided them
            const cleanLine = line.replace(/^[-*•\d+.)]\s+/, '');
            return `<li>${cleanLine}</li>`;
        }).join('');
        return `<ul class="mt-2">${items}</ul>`;
    }
    
    return formatted.replace(/\n/g, '<br>');
  }
</script>

<%- include("partials/footer") %>