<%- include("partials/header") %>

<section class="hero-card p-5 mb-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h1 class="display-6 fw-semibold">📚 Story Archive</h1>
      <p class="text-muted mb-0">
        Browse past entries and revisit your highlights. Each story is saved by date for quick retrieval.
      </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <% if (stories.length > 0) { %>
      <a class="btn btn-primary" href="/download-all">📄 Download All</a>
      <% } %>
      <a class="btn btn-danger" href="/archive-logout">🔒 Exit Archive</a>
    </div>
  </div>
</section>

<!-- Daily Stories Section -->
<section class="mb-5">
  <h2 class="display-7 fw-semibold mb-4">📖 Daily Stories</h2>
  <div class="row g-4" id="gridView">
    <% const dailyStories = stories.filter(s => s.category === "daily" || (!s.category && s.category !== "love")); %>
    <% if (dailyStories.length === 0) { %>
    <div class="col-12">
      <div class="story-card p-4">
        <p class="text-muted mb-0">No daily stories yet. Start writing today!</p>
      </div>
    </div>
    <% } %>
    <% dailyStories.forEach((story) => { %>
    <% const canEdit = Date.now() - new Date(story.createdAt).getTime() <= 24 * 60 * 60 * 1000; %>
    <div class="col-md-6 col-lg-4">
      <div class="archive-card p-4 h-100 d-flex flex-column">
        <div class="card-meta mb-3">
          <span class="text-muted"><%= story.formattedDate %></span>
        </div>
        <h5 class="fw-semibold"><%= story.title || "Untitled Story" %></h5>
        <p class="text-muted flex-grow-1">
          <%= story.content ? story.content.slice(0, 120) + (story.content.length > 120 ? "..." : "") : "" %>
        </p>
        <div class="text-muted small mb-3">
          <%= canEdit ? "Editing available (24h window)" : "Edit window expired" %>
        </div>
        <a class="btn btn-outline-light mt-auto" href="/story/<%= story._id %>">Read</a>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<!-- Love Stories Section -->
<section>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h2 class="display-7 fw-semibold mb-0">💕 Love Stories of Veeran</h2>
    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-primary" href="/add-love-story" style="background-color: #ff69b4; border-color: #ff69b4;">💕 Add Love Story</a>
      <% const loveStories = stories.filter(s => s.category === "love"); %>
      <% if (loveStories.length > 0) { %>
      <a class="btn btn-primary" href="/download-love-stories" style="background-color: #ff1493; border-color: #ff1493;">💾 Download Love Stories</a>
      <% } %>
    </div>
  </div>
  <div class="row g-4" id="loveStoriesView">
    <% if (loveStories.length === 0) { %>
    <div class="col-12">
      <div class="story-card p-4">
        <p class="text-muted mb-0">No love stories yet. Share your beautiful moments!</p>
      </div>
    </div>
    <% } %>
    <% loveStories.forEach((story) => { %>
    <% const canEdit = Date.now() - new Date(story.createdAt).getTime() <= 24 * 60 * 60 * 1000; %>
    <div class="col-md-6 col-lg-4">
      <div class="archive-card p-4 h-100 d-flex flex-column" style="border-left: 3px solid #ff69b4;">
        <div class="card-meta mb-3">
          <span class="text-muted"><%= story.formattedDate %></span>
        </div>
        <h5 class="fw-semibold" style="color: #ff69b4;"><%= story.title || "Untitled Love Story" %></h5>
        <p class="text-muted flex-grow-1">
          <%= story.content ? story.content.slice(0, 120) + (story.content.length > 120 ? "..." : "") : "" %>
        </p>
        <div class="text-muted small mb-3">
          <%= canEdit ? "Editing available (24h window)" : "Edit window expired" %>
        </div>
        <a class="btn btn-outline-light mt-auto" href="/story/<%= story._id %>">Read</a>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<%- include("partials/footer") %>
