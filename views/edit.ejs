<%- include("partials/header") %>

<section class="hero-card p-4 p-lg-5 mb-4">
  <h1 class="display-6 fw-semibold">Edit Past Entry</h1>
  <p class="text-muted mb-0">
    Updates are available only within 24 hours of the original submission.
  </p>
</section>

<section class="story-card p-4 p-lg-5">
  <form method="POST" action="/story/<%= story._id %>/edit">
    <div class="row g-4">
      <div class="col-lg-8">
        <label class="form-label">Title</label>
        <input
          type="text"
          name="title"
          class="form-control"
          value="<%= story.title %>"
          placeholder="Give your story a title"
        />
      </div>
      <div class="col-12">
        <label class="form-label">Your Story</label>
        <textarea
          name="content"
          class="form-control"
          rows="10"
        ><%= story.content %></textarea>
      </div>
      <div class="col-12 d-flex flex-wrap gap-3">
        <button class="btn btn-primary" type="submit">Save Changes</button>
        <a class="btn btn-outline-light" href="/story/<%= story._id %>">Cancel</a>
      </div>
    </div>
  </form>
</section>

<%- include("partials/footer") %>
