# ============ ENVIRONMENT CONFIGURATION ============
# development | staging | production
NODE_ENV=production

# ============ SERVER CONFIGURATION ============
PORT=3000

# ============ DATABASE CONFIGURATION ============
# MongoDB connection string
# Development: mongodb://localhost:27017/daily_story
# Production: mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/daily_story

# ============ SECURITY CONFIGURATION ============
# SESSION_SECRET: Cryptographically random 32+ character string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-32-character-random-string-here

# MAIN_PASSWORD: Bcrypt hashed password for main website login
# Default plain text: veeran_secure_password_2026
# To generate: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 10).then(h => console.log(h));"
MAIN_PASSWORD=$2b$10$YOUR_BCRYPT_HASH_HERE

# ARCHIVE_PASSWORD: Bcrypt hashed password for archive access
# Default plain text: darling_secret_love_stories
ARCHIVE_PASSWORD=$2b$10$YOUR_BCRYPT_HASH_HERE

# ALLOWED_ORIGINS: CORS allowed origins (comma-separated)
# Development: http://localhost:3000,http://localhost:3001
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ============ API KEYS ============
# Google Generative AI API key for fitness coach
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# ============ ERROR MONITORING (OPTIONAL) ============
# Sentry DSN for real-time error tracking
# Sign up at: https://sentry.io/
# Format: https://key@sentry.io/project_id
SENTRY_DSN=

# ============ PRODUCTION CHECKLIST ============
# [ ] Set NODE_ENV=production
# [ ] Change MAIN_PASSWORD to bcrypt hash (NEVER use plain text!)
# [ ] Change ARCHIVE_PASSWORD to bcrypt hash (NEVER use plain text!)
# [ ] Generate secure SESSION_SECRET (32+ chars)
# [ ] Update MONGODB_URI to production database with authentication
# [ ] Update ALLOWED_ORIGINS to your domain
# [ ] Enable HTTPS on hosting provider
# [ ] Set up MongoDB authentication and backups
# [ ] Configure Sentry DSN for error monitoring (optional)
# [ ] Review SECURITY.md for complete security checklist

# ⚠️ SECURITY WARNING ⚠️
# - NEVER commit .env file to version control
# - Change all default passwords immediately
# - Use bcrypt hashed passwords only (never plain text)
# - Generate cryptographically secure random SESSION_SECRET
# - Keep API keys confidential
